rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User profiles and encrypted key bundles
    match /users/{userId} {
      // Any authenticated user can read public profile metadata (displayName, photoURL, publicKey)
      allow read: if isSignedIn();
      // Only the profile owner can create or update their own document
      allow create, update: if isOwner(userId);
      allow delete: if false;

      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Group conversations and channels
    match /groups/{groupId} {
      function isGroupMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }

      allow read: if isGroupMember();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.members;
      allow update: if isGroupMember();
      allow delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;

      match /channels/{channelId} {
        function isParentGroupMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        }

        allow read, write: if isParentGroupMember();

        match /messages/{messageId} {
          allow read: if isParentGroupMember();
          allow create: if isParentGroupMember() &&
            request.resource.data.senderId == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }

    // Direct messages (1:1 E2EE conversations)
    match /directMessages/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }

      allow read: if isParticipant();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if isParticipant();
      allow delete: if false;

      match /messages/{messageId} {
        function isParentParticipant() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/directMessages/$(conversationId)).data.participants;
        }

        allow read: if isParentParticipant();
        allow create: if isParentParticipant() &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
